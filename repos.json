{
	"owner": "raine-works",
	"review": ["code-review / review"],
	"repos": {
		"agents": { "checks": ["actionlint"], "codeOwnerReview": true },
		"raineworks": { "checks": ["plan / plan", "checks / Lint", "checks / Typecheck", "checks / Test"] },
		"ha-dashboards": {
			"checks": ["Dashboards (lint, types, tests)", "Integration (ruff, pytest)", "hacs", "hassfest"]
		},
		"ha-googletv": { "checks": ["Lint and unit tests", "Home Assistant tests", "hacs", "hassfest"] },
		"ha-grok": { "checks": ["Lint and tests", "hacs", "hassfest"] },
		"ha-music-assistant": { "checks": ["Lint and tests", "hacs", "hassfest"] },
		"ha-everscent": { "checks": ["Home Assistant config-flow tests", "Lint and unit tests", "hacs", "hassfest"] },
		"ha-warden": { "checks": ["Lint and tests", "hacs", "hassfest"] },
		"ha-gitops": { "checks": ["Lint and tests", "hacs", "hassfest"] },
		"sendspin-a1s-source": { "checks": [] },
		".dotfiles": { "checks": ["smoke-check"] },
		"devcontainer-features": {
			"checks": [
				"validate",
				"version-bump",
				"test-scenarios (bun)",
				"test-scenarios (deno)",
				"test-scenarios (node)",
				"test-autogenerated (bun, debian:latest)",
				"test-autogenerated (bun, ubuntu:latest)",
				"test-autogenerated (bun, mcr.microsoft.com/devcontainers/base:ubuntu)",
				"test-autogenerated (deno, debian:latest)",
				"test-autogenerated (deno, ubuntu:latest)",
				"test-autogenerated (deno, mcr.microsoft.com/devcontainers/base:ubuntu)",
				"test-autogenerated (node, debian:latest)",
				"test-autogenerated (node, ubuntu:latest)",
				"test-autogenerated (node, mcr.microsoft.com/devcontainers/base:ubuntu)"
			]
		}
	}
}
